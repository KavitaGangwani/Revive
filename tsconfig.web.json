{
  "compilerOptions": {
    "composite": true,
    "target": "ESNext",
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "src/renderer/src/**/*",
    "src/renderer/src/env.d.ts",
    "src/preload/index.d.ts",
    "src/shared/**/*"
  ]
}
